# Dependencies and build output
node_modules/
dist
*.tsbuildinfo

# Environment: every .env file is ignored except the two examples
.env
.env.*
!.env.example
!deploy/.env.production.example
# Production secrets on the server (also covered by .env.*, kept explicit)
deploy/.env.production

# Backup output (never commit real data)
backups/
*.dump
*.dump.partial

# Logs
logs
*.log
npm-debug.log*

# Tests and tooling caches
coverage
.eslintcache

# Local uploads and generated Prisma client
uploads/
src/generated/
