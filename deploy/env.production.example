# Copy to asico-server/.env on the server:  cp deploy/env.production.example .env  && nano .env
# Never commit the real .env.

# ---- Domain and HTTPS (Caddy) ----
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# ---- Database ----
# Use letters and numbers only in the password (it goes inside a URL): openssl rand -hex 24
POSTGRES_USER=elecico
POSTGRES_PASSWORD=CHANGE_ME_hex_password
POSTGRES_DB=elecico

# ---- Security ----
# At least 32 characters: openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_long_random_secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SAMESITE=strict

# Caddy -> nginx -> app: two proxies in front of the API.
TRUST_PROXY=2
CORS_ORIGINS=https://app.example.com

# ---- Files ----
# stream: the API sends the files itself (no extra nginx setup needed).
FILE_DELIVERY=stream
MAX_UPLOAD_BYTES=26214400
MAX_DOCUMENTS_PER_VILLA=10

# ---- App ----
LOG_LEVEL=info
APP_TIMEZONE=Asia/Kuwait
SMALL_WORKS_ALERT_JOB_ENABLED=true
SMALL_WORKS_ALERT_HOURS_BEFORE=8
PASSWORD_RESET_URL=https://app.example.com/reset-password

# ---- Mail (all six required in production) ----
# Gmail: turn on 2-Step Verification, then create an App Password (16 letters, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=abcdabcdabcdabcd
MAIL_FROM="Elecico <you@gmail.com>"

# ---- First admin (used once by the seed command) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_at_least_12_chars
