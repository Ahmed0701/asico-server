# Elecico API - production environment.
# Copy on the server:  cp deploy/.env.production.example deploy/.env.production  && chmod 600 deploy/.env.production
# Then replace every CHANGE_ME. deploy/.env.production is git-ignored; never commit it.
# Generate secrets with:  openssl rand -hex 24  (passwords)  /  openssl rand -hex 48  (JWT secret)

# ============================================================ Docker Compose / host
# Read by docker-compose.prod.yml (not by the Node process).

# The public host name. Caddy gets and renews its HTTPS certificate. No scheme, no path.
DOMAIN=app.example.com
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=CHANGE_ME@example.com
# PostgreSQL user that owns the database (created on the first start of the db container).
POSTGRES_USER=elecico
# PostgreSQL password. Letters and digits only (it goes inside DATABASE_URL). Do not change it after the first start.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# PostgreSQL database name.
POSTGRES_DB=elecico

# ============================================================ Core
# Required. development | test | production. Production turns on the strict checks (secure cookie, SMTP required).
NODE_ENV=production
# Port the API listens on inside its container. nginx forwards /api to it.
PORT=8080
# Required. PostgreSQL connection URL. Same user, password and database as above; host "db" is the compose service.
# docker-compose.prod.yml also builds this from the POSTGRES_* values, so keep the two in step.
DATABASE_URL=postgresql://elecico:CHANGE_ME_POSTGRES_PASSWORD@db:5432/elecico?schema=public
# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# How long to wait for open requests on shutdown (ms) before the process exits.
SHUTDOWN_TIMEOUT_MS=10000

# ============================================================ Database pool
# Most connections the API opens to PostgreSQL.
DB_POOL_MAX=10
# Give up opening a connection after this long (ms).
DB_CONNECTION_TIMEOUT_MS=5000
# Close a connection left idle this long (ms).
DB_IDLE_TIMEOUT_MS=30000

# ============================================================ HTTP
# Allowed browser origins, comma separated. The frontend is on the same domain, so only that origin.
CORS_ORIGINS=https://app.example.com
# Number of reverse proxies in front of the API: Caddy -> nginx -> API = 2. Wrong values break client IPs and rate limits.
TRUST_PROXY=2
# Largest JSON body accepted (file uploads have their own limit below).
BODY_LIMIT=100kb
# Global rate limit: requests per window per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Excel/PDF export rate limit per client IP.
EXPORT_RATE_LIMIT_WINDOW_MS=60000
EXPORT_RATE_LIMIT_MAX=10
# Excel import rate limit per client IP.
IMPORT_RATE_LIMIT_WINDOW_MS=60000
IMPORT_RATE_LIMIT_MAX=10

# ============================================================ Auth
# Required, at least 32 characters. Signs the access tokens. Changing it signs everyone out.
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_AT_LEAST_32_CHARS
# Access token lifetime in seconds (900 = 15 minutes).
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days: a user idle this long must sign in again.
REFRESH_TOKEN_TTL_DAYS=7
# Sign-in and password endpoints: requests per window per client IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# POST /auth/refresh has its own, wider limit (every open tab refreshes).
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=30
# Refresh cookie Secure flag. Leave empty: it is on in production, and "false" is refused in production.
REFRESH_COOKIE_SECURE=
# Refresh cookie SameSite: strict, because the frontend and the API share one domain.
REFRESH_COOKIE_SAMESITE=strict
# Refresh cookie Domain. Leave empty: the cookie belongs to the API host only.
REFRESH_COOKIE_DOMAIN=
# The frontend page the password reset email links to.
PASSWORD_RESET_URL=https://app.example.com/reset-password
# NOT READ BY THE SERVER TODAY. Kept for the deployment checklist. POST /auth/signup is always open and creates an
# account that waits for an administrator's approval; setting this variable does not turn sign-up off.
AUTH_SIGNUP_ENABLED=false

# ============================================================ Files
# Folder for uploaded files inside the container. The compose file mounts the "uploads" volume there.
UPLOAD_DIR=uploads
# How downloads are sent: stream (the API sends the file) or accel (nginx via X-Accel-Redirect).
# Use stream: the bundled nginx has no /protected-files/ location, and accel would send EMPTY (0 KB) files.
FILE_DELIVERY=stream
# Largest uploaded file in bytes (26214400 = 25 MB). nginx allows 260 MB per request (10 delivery notes).
MAX_UPLOAD_BYTES=26214400
# Most documents a villa can hold.
MAX_DOCUMENTS_PER_VILLA=10

# ============================================================ Small works deadlines
# IANA time zone the small works deadlines are counted in.
APP_TIMEZONE=Asia/Kuwait
# A pending small work is "due soon" this many hours before the end of its end date (1 to 72).
SMALL_WORKS_ALERT_HOURS_BEFORE=8
# The hourly job that raises due soon / overdue notifications and emails the administrators: true or false.
SMALL_WORKS_ALERT_JOB_ENABLED=true

# ============================================================ Email (required in production: all six)
# Gmail: turn on 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
# 465 with SMTP_SECURE=true (TLS), or 587 with SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465
SMTP_SECURE=true
# The sending account.
SMTP_USER=CHANGE_ME@gmail.com
# The App Password: 16 characters, no spaces.
SMTP_PASS=CHANGE_ME_SMTP_APP_PASSWORD
# From header. With Gmail it must be the same address as SMTP_USER.
MAIL_FROM="Elecico <CHANGE_ME@gmail.com>"

# ============================================================ First admin (seed only)
# Read once by: docker compose -f docker-compose.prod.yml run --rm migrate npx tsx prisma/seed.ts
# Ignored when an admin already exists. Remove ADMIN_PASSWORD from the file after the first sign-in.
ADMIN_EMAIL=CHANGE_ME@example.com
# At least 12 characters (at most 72 bytes).
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ============================================================ Scripts
# scripts/demo-seed.ts refuses to run in production unless this is "yes". Never set it on a real database.
DEMO_SEED_ALLOW_PRODUCTION=no
