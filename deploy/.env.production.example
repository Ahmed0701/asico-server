# Asico (Elecico) production environment. Lives on the server only.
#   cd /opt/asico/asico-server/deploy
#   cp .env.production.example .env.production && chmod 600 .env.production && nano .env.production
# Replace EVERY CHANGE_ME: the API refuses to start while any of its settings still says CHANGE_ME, and the deploy
# scripts refuse to run while any line does. deploy/.env.production is git-ignored; never commit it or paste it anywhere.
# Rules: one NAME=value per line, no spaces around "=", no "$" in any value (docker compose would expand it).
# Secrets:  openssl rand -base64 48 | tr '+/' '-_' | tr -d '='   (JWT_ACCESS_SECRET)
#           openssl rand -hex 24                                  (POSTGRES_PASSWORD: letters and digits, safe in a URL)

# ============================================================ Docker Compose (read by docker-compose.prod.yml)
# The site's host name, without https://. Caddy gets its HTTPS certificate for it.
DOMAIN=CHANGE_ME.example.com
# The built frontend on the host, served read-only by Caddy (deploy-frontend.sh copies dist/ here).
FRONTEND_DIST_DIR=/opt/asico/frontend-dist
# PostgreSQL 17, created on the first start of the db container. Changing them later does not change the database.
POSTGRES_USER=asico
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=asico

# ============================================================ Core
# development | test | production. Production needs the SMTP settings and keeps the refresh cookie Secure.
NODE_ENV=production
# The API's port inside its container (Caddy reaches it as app:8080; it is not published).
PORT=8080
# PostgreSQL URL: the same user, password and database as above. "db" is the database container, not localhost.
DATABASE_URL=postgresql://asico:CHANGE_ME_POSTGRES_PASSWORD@db:5432/asico?schema=public
# fatal | error | warn | info | debug | trace | silent. JSON lines on stdout (docker compose logs app).
LOG_LEVEL=info
# On SIGTERM the API finishes open requests for at most this long (ms); the container allows 30 s.
SHUTDOWN_TIMEOUT_MS=10000

# ============================================================ Database pool
# Most connections the API keeps to PostgreSQL.
DB_POOL_MAX=10
# Give up opening a connection after this long (ms).
DB_CONNECTION_TIMEOUT_MS=5000
# Close a connection idle this long (ms).
DB_IDLE_TIMEOUT_MS=30000

# ============================================================ HTTP
# Browser origins allowed by CORS, comma separated. Empty: the frontend and the API share one origin.
CORS_ORIGINS=
# Reverse proxies in front of the API: 1 (Caddy). Set 2 when the Cloudflare proxy (orange cloud) is on, or client IPs
# and the rate limits see Cloudflare instead of the visitor.
TRUST_PROXY=1
# Largest JSON body. File uploads have their own limit (MAX_UPLOAD_BYTES) and Caddy's (30 MB, 260 MB for delivery notes).
BODY_LIMIT=100kb
# All requests: at most RATE_LIMIT_MAX per RATE_LIMIT_WINDOW_MS per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Excel and PDF exports per client IP.
EXPORT_RATE_LIMIT_WINDOW_MS=60000
EXPORT_RATE_LIMIT_MAX=10
# Excel imports per client IP.
IMPORT_RATE_LIMIT_WINDOW_MS=60000
IMPORT_RATE_LIMIT_MAX=10

# ============================================================ Auth
# Signs the access tokens; at least 32 characters. Changing it signs everyone out.
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET
# Access token lifetime in seconds (900 = 15 minutes).
JWT_ACCESS_TTL_SECONDS=900
# Days a session lasts without use before signing in again.
REFRESH_TOKEN_TTL_DAYS=7
# Sign-in and password endpoints, per client IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# POST /auth/refresh has its own wider limit (every open tab refreshes).
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=30
# The refresh cookie travels over HTTPS only. "false" is refused in production.
REFRESH_COOKIE_SECURE=true
# strict: the frontend and the API are on the same site.
REFRESH_COOKIE_SAMESITE=strict
# Empty: the cookie belongs to this host only.
REFRESH_COOKIE_DOMAIN=
# Public sign-up (POST /auth/signup). false: only an administrator creates users (Users page). Unset is also off here.
AUTH_SIGNUP_ENABLED=false
# The frontend's reset page; the email link adds ?token=... to it.
PASSWORD_RESET_URL=https://CHANGE_ME.example.com/reset-password

# ============================================================ Documents
# Folder for villa documents and delivery notes inside the container (the "documents" volume).
UPLOAD_DIR=/app/uploads
# stream: the API sends files itself. Keep it: Caddy has no X-Accel-Redirect, and "accel" would send EMPTY files.
FILE_DELIVERY=stream
# Largest file in bytes (26214400 = 25 MB).
MAX_UPLOAD_BYTES=26214400
# Most documents one villa can hold.
MAX_DOCUMENTS_PER_VILLA=10

# ============================================================ Small works alerts
# The time zone small works deadlines and alerts are counted in.
APP_TIMEZONE=Asia/Kuwait
# A pending small work is "due soon" this many hours before the end of its end date (1 to 72).
SMALL_WORKS_ALERT_HOURS_BEFORE=8
# The hourly check (notifications and the administrators' email). One instance at a time (database lock).
SMALL_WORKS_ALERT_JOB_ENABLED=true

# ============================================================ Email (all six required in production)
# Your SMTP service (Brevo, Resend, Mailgun, Amazon SES, Gmail App Password...): host, port and login.
SMTP_HOST=CHANGE_ME.smtp.example.com
# 465 with SMTP_SECURE=true (TLS), or 587 with SMTP_SECURE=false (STARTTLS).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
# The sender. Must be on a domain verified at the SMTP service (SPF and DKIM in Cloudflare DNS). With Gmail, the
# same address as SMTP_USER.
MAIL_FROM="Elecico <no-reply@CHANGE_ME.example.com>"

# ============================================================ First administrator (read by deploy/scripts/first-run.sh)
# Used once to create the first ADMIN; later changes here do nothing. Change the password in the app afterwards.
ADMIN_EMAIL=CHANGE_ME@example.com
# 12 to 72 characters.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ============================================================ Scripts
# The backup and restore scripts' folder on the host (outside both repositories).
BACKUP_DIR=/opt/asico/backups
# scripts/demo-seed.ts refuses production unless this is "yes". Never on real data.
DEMO_SEED_ALLOW_PRODUCTION=no
