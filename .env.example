# ---------- Core ----------
# REQUIRED: development | test | production
NODE_ENV=development
PORT=8080
# REQUIRED: PostgreSQL connection URL
DATABASE_URL="postgresql://postgres:2020@localhost:5432/elecico?schema=public"
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------- Seed (first admin, used by: npx prisma db seed) ----------
ADMIN_EMAIL=admin@asico.local
ADMIN_PASSWORD=Ahmed%402020

# ---------- Auth ----------
# REQUIRED: at least 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=RYVAIdxF4j3yoLiZBw0HacmCfasabQgA5yTLP_3saXuAQNviE10m5KQ9yd3r1PMZ
# Access token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=7
# Auth endpoints limiter: 10 requests per 15 minutes per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# POST /auth/refresh has its own limiter (every open tab refreshes when the access token expires): 30 requests per minute per IP
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=30
# The refresh cookie. Secure: true or false; unset = on everywhere except development. false is refused in production.
# SameSite: strict (default, the frontend and the API on one site), lax, or none (a frontend on another site; needs Secure).
# Domain: a bare host name such as example.com, only if the frontend shares a parent domain; unset = the API host alone.
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_DOMAIN=
# Must point to the FRONTEND reset page (not the API)
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# ---------- HTTP ----------
# Comma separated list of allowed browser origins (empty = none)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, 1 behind nginx)
TRUST_PROXY=0
BODY_LIMIT=100kb
# Global limiter: 300 requests per minute per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Export limiter: 10 requests per minute
EXPORT_RATE_LIMIT_WINDOW_MS=60000
EXPORT_RATE_LIMIT_MAX=10
IMPORT_RATE_LIMIT_WINDOW_MS=60000
IMPORT_RATE_LIMIT_MAX=10

# ---------- Files ----------
# Dev: relative folder. Production: /srv/asico/uploads
UPLOAD_DIR=uploads
# How downloads are sent: stream (this process sends the file) or accel (nginx sends it via X-Accel-Redirect).
# Unset: stream in development, accel elsewhere. Without the nginx /protected-files/ location, use stream.
FILE_DELIVERY=
# 26214400 = 25 MB
MAX_UPLOAD_BYTES=26214400
MAX_DOCUMENTS_PER_VILLA=10

# ---------- Database pool ----------
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# ---------- Small works deadlines ----------
# The time zone (an IANA name such as Asia/Kuwait) in which a small work ends at the END of its end date. Only the overdue and
# due-soon rules of the small works use it: "today" everywhere else in the API is still the UTC day.
APP_TIMEZONE=Asia/Kuwait
# A pending small work is "due soon" this many hours before the end of its end date (1 to 72)
SMALL_WORKS_ALERT_HOURS_BEFORE=8
# The hourly job that raises notifications (and one digest email to the administrators) for small works that are due soon or
# overdue: true or false. Run it by hand with: npm run jobs:small-works
SMALL_WORKS_ALERT_JOB_ENABLED=true

# ---------- Shutdown ----------
SHUTDOWN_TIMEOUT_MS=10000

# ---------- Email (Gmail App Password) ----------
# Optional in development (emails are written to a temp file instead).
# Required in production. All six together or none.
# If you set one, you must set all six.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
# 16 characters, no spaces
SMTP_PASS=abcdefghijklmnop
# With Gmail this must be the same address as SMTP_USER
MAIL_FROM="Elecico <your.address@gmail.com>"