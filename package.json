{
  "name": "asico-server",
  "version": "1.0.0",
  "description": "Backend API for Asico villa management: a modular monolith on Express, Prisma and PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "load:check": "vitest run --config vitest.load.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "mail:preview": "tsx scripts/preview-mail.ts",
    "idempotency:purge": "tsx scripts/purge-idempotency.ts",
    "jobs:small-works": "tsx scripts/run-small-works-job.ts",
    "check:slice19": "tsx scripts/check-slice19.ts",
    "cleanup:slice19": "tsx scripts/slice19-cleanup.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmed-abdelnaby10/asico-server.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ahmed-abdelnaby10/asico-server/issues"
  },
  "homepage": "https://github.com/ahmed-abdelnaby10/asico-server#readme",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "bidi-js": "1.1.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "nodemailer": "10.1.0",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "nodemon": "^3.1.14",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
